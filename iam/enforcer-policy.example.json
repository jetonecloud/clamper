{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Discover",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeAutoScalingGroups",
        "ec2:DescribeInstances",
        "ecs:DescribeServices",
        "ecs:ListClusters",
        "ecs:ListServices",
        "ecs:ListTagsForResource",
        "lambda:GetFunctionConcurrency",
        "lambda:ListFunctions",
        "lambda:ListTags",
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances",
        "rds:ListTagsForResource",
        "redshift:DescribeClusters",
        "sagemaker:DescribeNotebookInstance",
        "sagemaker:ListNotebookInstances",
        "sagemaker:ListTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2InstanceTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:123456789012:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/clamper:managed": "true"
        }
      }
    },
    {
      "Sid": "AutoscalingGroupTagged",
      "Effect": "Allow",
      "Action": [
        "autoscaling:UpdateAutoScalingGroup"
      ],
      "Resource": [
        "arn:aws:autoscaling:*:123456789012:autoScalingGroup:*:autoScalingGroupName/*"
      ],
      "Condition": {
        "StringEquals": {
          "autoscaling:ResourceTag/clamper:managed": "true"
        }
      }
    },
    {
      "Sid": "EcsServiceTagged",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService"
      ],
      "Resource": [
        "arn:aws:ecs:*:123456789012:service/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/clamper:managed": "true"
        }
      }
    },
    {
      "Sid": "RdsInstanceTagged",
      "Effect": "Allow",
      "Action": [
        "rds:StartDBInstance",
        "rds:StopDBInstance"
      ],
      "Resource": [
        "arn:aws:rds:*:123456789012:db:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/clamper:managed": "true"
        }
      }
    },
    {
      "Sid": "AuroraClusterTagged",
      "Effect": "Allow",
      "Action": [
        "rds:StartDBCluster",
        "rds:StopDBCluster"
      ],
      "Resource": [
        "arn:aws:rds:*:123456789012:cluster:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/clamper:managed": "true"
        }
      }
    },
    {
      "Sid": "LambdaFunctionTagged",
      "Effect": "Allow",
      "Action": [
        "lambda:DeleteFunctionConcurrency",
        "lambda:PutFunctionConcurrency"
      ],
      "Resource": [
        "arn:aws:lambda:*:123456789012:function:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/clamper:managed": "true"
        }
      }
    },
    {
      "Sid": "SagemakerNotebookTagged",
      "Effect": "Allow",
      "Action": [
        "sagemaker:StartNotebookInstance",
        "sagemaker:StopNotebookInstance"
      ],
      "Resource": [
        "arn:aws:sagemaker:*:123456789012:notebook-instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/clamper:managed": "true"
        }
      }
    },
    {
      "Sid": "RedshiftClusterTagged",
      "Effect": "Allow",
      "Action": [
        "redshift:PauseCluster",
        "redshift:ResumeCluster"
      ],
      "Resource": [
        "arn:aws:redshift:*:123456789012:cluster:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/clamper:managed": "true"
        }
      }
    },
    {
      "Sid": "ReadOwnBudgets",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget"
      ],
      "Resource": [
        "arn:aws:budgets::123456789012:budget/clamper-whole-account"
      ]
    },
    {
      "Sid": "Ledger",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:123456789012:table/clamper-ledger",
        "arn:aws:dynamodb:*:123456789012:table/clamper-ledger/index/*"
      ]
    },
    {
      "Sid": "Notify",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": [
        "arn:aws:sns:*:123456789012:clamper-notifications"
      ]
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:123456789012:log-group:/aws/lambda/clamper-enforcer:*"
      ]
    }
  ]
}
